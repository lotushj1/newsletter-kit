# ── 基本設定 ────────────────────────────────────────────────
PORT=4400
# 對外網址，確認信與退訂連結會用它組出絕對路徑
PUBLIC_BASE_URL=http://localhost:4400
# 顯示在後台與信件頁尾的站名（改成你自己的）
SITE_NAME=My Newsletter

# ── 安全性（正式環境必填）────────────────────────────────────
# 用來簽確認信／退訂 token，換掉它等於讓舊連結失效
APP_SECRET=change-me-to-a-long-random-string
# 後台登入用的單一 token
ADMIN_TOKEN=change-me-too

# ── 儲存 ────────────────────────────────────────────────────
# sqlite（預設）| json | memory
STORE_DRIVER=sqlite
STORE_PATH=./data/newsletter.db

# ── 寄信 ────────────────────────────────────────────────────
# 本系統不寄信，只呼叫你選的 adapter
# dry_run（預設，只寫 log）| webhook | resend | zeabur
EMAIL_PROVIDER=dry_run
MAIL_FROM=Newsletter <newsletter@example.com>
MAIL_REPLY_TO=

# EMAIL_PROVIDER=webhook 時
WEBHOOK_URL=
# 有填就會帶 X-Newsletter-Signature（HMAC-SHA256 of body）
WEBHOOK_SECRET=

# EMAIL_PROVIDER=resend 時
RESEND_API_KEY=

# EMAIL_PROVIDER=zeabur 時（自架寄信服務的範例）
ZEABUR_ENDPOINT=
ZEABUR_TOKEN=

# ── 訂閱行為 ────────────────────────────────────────────────
# true = 寄確認信後才算訂閱成功（double opt-in）
DOUBLE_OPT_IN=true
# 訂閱表單允許的來源網域，逗號分隔；* 代表全開（只建議本機用）
CORS_ORIGINS=*
# 同一 IP 每分鐘最多幾次公開訂閱請求
PUBLIC_RATE_LIMIT_PER_MIN=20

# ── 寄送節流與排程 ──────────────────────────────────────────
SEND_BATCH_SIZE=20
SEND_BATCH_DELAY_MS=1000
SEND_MAX_ATTEMPTS=3
SCHEDULER_ENABLED=true
SCHEDULER_POLL_MS=30000

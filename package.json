{
  "name": "newsletter-kit",
  "version": "0.1.0",
  "description": "Self-hosted newsletter management (compose, list, schedule, preview). Bring your own email provider.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "admin/dist",
    "docs",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite build --watch --config admin/vite.config.mjs\"",
    "dev:server": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && vite build --config admin/vite.config.mjs",
    "build:admin": "vite build --config admin/vite.config.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:tables": "NK_TEST_STORE=tables vitest run --testTimeout=60000 --hookTimeout=60000",
    "test:watch": "vitest",
    "mcp": "tsx src/mcp/cli.ts"
  },
  "keywords": [
    "newsletter",
    "email",
    "self-hosted",
    "cms",
    "subscribers",
    "scheduler"
  ],
  "overrides": {
    "qs": "^6.16.0",
    "proxy-addr": "^2.0.8",
    "body-parser": "^2.4.0",
    "markdown-it": "^14.3.3",
    "@insforge/shared-schemas": {
      "zod": "^4.6.6"
    }
  },
  "dependencies": {
    "@insforge/sdk": "^1.5.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-text-align": "^3.35.0",
    "@tiptap/extensions": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "lucide-react": "^0.487.0",
    "marked": "^15.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.2.5",
    "happy-dom": "^21.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "vitest": "^5.0.0"
  }
}
